---
import SpecSheet from '@/components/ui/SpecSheet.astro';
import ProjectCover from '@/components/ui/ProjectCover.astro';
import { metaLine, projectUrl, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { title, summary, specs, stack, accent } = project.data;
---

<div class="h-full" style={`--delay:${delay}ms`} data-reveal>
  <a
    href={projectUrl(project)}
    class="card group flex h-full flex-col overflow-hidden hover:shadow-[0_24px_60px_-20px_rgb(0_0_0/0.25)]"
    data-tilt="3"
    style={`--accent-p:${accent}`}
  >
    <div class="aspect-[16/10] overflow-hidden border-b border-line">
      <div class="size-full transition-transform duration-700 ease-(--ease-apple) group-hover:scale-[1.04]">
        <ProjectCover project={project} />
      </div>
    </div>

    <div class="flex flex-1 flex-col p-7 sm:p-9">
      <p class="eyebrow flex items-center gap-2">
        <span class="size-2 rounded-full bg-(--accent-p)"></span>
        {metaLine(project)}
      </p>

      <h3 class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h3>
      <p class="mt-3 leading-relaxed text-muted">{summary}</p>

      <div class="mt-auto pt-8">
        {specs.length > 0 && <SpecSheet specs={specs.slice(0, 4)} />}
        <div class="mt-6 flex items-center justify-between gap-4">
          <p class="truncate font-mono text-xs text-muted">{stack.join(' · ')}</p>
          <span
            class="grid size-9 shrink-0 place-items-center rounded-full bg-surface-2 text-ink transition-all duration-500 group-hover:bg-(--accent-p) group-hover:text-white"
            aria-hidden="true"
          >
            →
          </span>
        </div>
      </div>
    </div>
  </a>
</div>
