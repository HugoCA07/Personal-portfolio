---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="grid min-h-[80svh] place-items-center px-5 pt-24 text-center">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-5 text-[clamp(3rem,12vw,8rem)] leading-none font-semibold tracking-[-0.05em]">Fuera de ruta.</h1>
      <p class="mx-auto mt-6 max-w-md text-lg text-muted">Esta carretera no lleva a ninguna parte. Volvamos al punto de partida.</p>
      <a href="/" class="mt-10 inline-block rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
