---
/**
 * Paleta de comandos (Ctrl/⌘ + K o el botón de búsqueda del header).
 * Lista secciones, proyectos y acciones rápidas; se filtra escribiendo y se maneja con el teclado.
 * Los datos salen de `site.ts` y de la colección de proyectos: no hay que mantener nada aquí.
 */
import { nav, site } from '@/config/site';
import { categoryLabel, getProjects, projectUrl } from '@/lib/projects';
import { url } from '@/lib/url';

const projects = await getProjects();

type Item = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean; keywords?: string };
const items: Item[] = [
  ...nav.map((n) => ({ group: 'Secciones', label: n.label, href: url(n.href) })),
  { group: 'Secciones', label: 'Todos los proyectos', href: url('/proyectos/') },
  // Los proyectos también se encuentran por sus tecnologías ("java", "c++"…)
  ...projects.map((p) => ({
    group: 'Proyectos',
    label: p.data.title,
    hint: categoryLabel[p.data.category],
    href: projectUrl(p),
    keywords: p.data.stack.join(' '),
  })),
  { group: 'Acciones', label: 'Copiar mi email', hint: site.email, action: 'copy-email' },
  { group: 'Acciones', label: 'Cambiar entre modo claro y oscuro', action: 'theme' },
  { group: 'Acciones', label: 'Abrir GitHub', hint: `@${site.github.user}`, href: site.github.url, external: true },
  { group: 'Acciones', label: 'Abrir LinkedIn', href: site.linkedin, external: true },
];
const groups = [...new Set(items.map((i) => i.group))];
---

<dialog id="palette" class="palette" aria-label="Buscar en la web">
  <div class="panel glass-panel">
    <div class="flex items-center gap-3 border-b border-line px-5">
      <svg class="size-[18px] shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="palette-input"
        type="text"
        class="h-14 w-full bg-transparent text-base text-ink outline-none placeholder:text-muted"
        placeholder="Busca secciones, proyectos, tecnologías…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
      />
      <kbd class="hidden rounded-md border border-line px-1.5 py-0.5 font-mono text-[11px] text-muted sm:block">Esc</kbd>
    </div>

    <div id="palette-list" class="max-h-[min(60svh,26rem)] overflow-y-auto overscroll-contain p-2" role="listbox">
      {
        groups.map((g) => (
          <div class="group-block" data-group>
            <p class="px-3 pt-3 pb-1.5 font-mono text-[10px] tracking-[0.14em] text-muted uppercase">{g}</p>
            {items
              .filter((i) => i.group === g)
              .map((i) =>
                i.href ? (
                  <a
                    href={i.href}
                    class="item"
                    role="option"
                    data-item
                    data-search={`${i.label} ${i.hint ?? ''} ${i.keywords ?? ''} ${g}`}
                    target={i.external ? '_blank' : undefined}
                    rel={i.external ? 'noopener' : undefined}
                  >
                    <span class="truncate">{i.label}</span>
                    {i.hint && <span class="hint">{i.hint}</span>}
                  </a>
                ) : (
                  <button type="button" class="item" role="option" data-item data-action={i.action} data-search={`${i.label} ${i.hint ?? ''} ${i.keywords ?? ''} ${g}`}>
                    <span class="truncate">{i.label}</span>
                    {i.hint && <span class="hint">{i.hint}</span>}
                  </button>
                ),
              )}
          </div>
        ))
      }
      <p class="empty hidden px-3 py-8 text-center text-sm text-muted">No hay resultados.</p>
    </div>

    <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-2.5 font-mono text-[10px] text-muted">
      <span>↑ ↓ para moverte · Enter para abrir</span>
      <span class="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  .palette {
    margin: 12svh auto auto;
    width: min(36rem, calc(100vw - 2rem));
    max-height: none;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
    color: var(--ink);
  }
  .palette::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(4px);
  }
  .palette[open] .panel {
    animation: pop 0.25s var(--ease-apple);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .glass-panel {
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.45);
  }
  .item {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 0.75rem;
    padding: 0.65rem 0.75rem;
    text-align: left;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .item[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .item[aria-selected='true'] .hint {
    color: inherit;
    opacity: 0.8;
  }
  .hint {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
</style>

<script>
  import { site } from '@/config/site';

  const dialog = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')];
  const blocks = [...dialog.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = dialog.querySelector<HTMLElement>('.empty')!;
  const status = dialog.querySelector<HTMLElement>('.status')!;

  // Búsqueda sin tildes ni mayúsculas
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  let visible: HTMLElement[] = items;
  let index = 0;

  const select = (i: number) => {
    index = (i + visible.length) % Math.max(visible.length, 1);
    visible.forEach((el, n) => el.setAttribute('aria-selected', String(n === index)));
    visible[index]?.scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const words = norm(input.value).split(/\s+/).filter(Boolean);
    visible = items.filter((el) => {
      const ok = words.every((w) => norm(el.dataset.search ?? '').includes(w));
      el.hidden = !ok;
      el.removeAttribute('aria-selected');
      return ok;
    });
    blocks.forEach((b) => (b.hidden = !b.querySelector('[data-item]:not([hidden])')));
    empty.hidden = visible.length > 0;
    empty.classList.toggle('hidden', visible.length > 0);
    select(0);
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    status.textContent = '';
    filter();
    dialog.showModal();
    input.focus();
  };

  const run = async (el: HTMLElement) => {
    const action = el.dataset.action;
    if (action === 'copy-email') {
      try {
        await navigator.clipboard.writeText(site.email);
        status.textContent = 'Email copiado';
      } catch {
        status.textContent = site.email;
      }
      return;
    }
    if (action === 'theme') {
      document.getElementById('theme-toggle')?.click();
      dialog.close();
      return;
    }
    dialog.close();
    if (el instanceof HTMLAnchorElement) el.click();
  };

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), select(index + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), select(index - 1));
    else if (e.key === 'Enter' && visible[index]) (e.preventDefault(), run(visible[index]));
  });
  items.forEach((el) => {
    el.addEventListener('mousemove', () => select(visible.indexOf(el)));
    el.addEventListener('click', (e) => {
      if (el.dataset.action) (e.preventDefault(), run(el));
      else dialog.close();
    });
  });
  // Cerrar al pulsar fuera del panel
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));
</script>
