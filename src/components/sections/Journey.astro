---
import Section from '@/components/ui/Section.astro';
import { timeline } from '@/data/timeline';
---

<Section id="trayectoria" eyebrow="Trayectoria" title="Paso a paso.">
  <ol class="timeline relative ml-3 sm:mx-auto sm:max-w-3xl">
    {
      timeline.map((m, i) => (
        <li
          class:list={[
            'relative pb-14 pl-10 last:pb-0 sm:w-1/2 sm:pl-0',
            i % 2 === 0 ? 'sm:pr-14 sm:text-right' : 'sm:ml-auto sm:pl-14',
          ]}
          data-reveal
        >
          <span
            class:list={[
              'marker absolute top-1 -left-[9px] grid size-[18px] place-items-center rounded-full border-2 bg-canvas',
              i % 2 === 0 ? 'sm:right-[-9px] sm:left-auto' : 'sm:-left-[9px]',
              m.current ? 'border-accent' : m.future ? 'border-dashed border-muted' : 'border-ink',
            ]}
            aria-hidden="true"
          >
            {m.current && <span class="size-2 animate-pulse rounded-full bg-accent" />}
          </span>
          <p class:list={['font-mono text-xs tracking-[0.14em] uppercase', m.current ? 'text-accent' : 'text-muted']}>
            {m.year}
          </p>
          <h3 class:list={['mt-2 text-2xl font-semibold tracking-tight', m.future && 'text-muted']}>{m.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{m.text}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* Línea vertical de la trayectoria */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: -0.5px;
    width: 1px;
    background: linear-gradient(to bottom, var(--line), var(--muted) 15%, var(--muted) 85%, transparent);
    opacity: 0.5;
  }
  @media (min-width: 640px) {
    .timeline::before {
      left: calc(50% - 0.5px);
    }
  }
  .marker {
    z-index: 1;
  }
</style>
