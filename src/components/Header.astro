---
import { nav, site } from '@/config/site';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="border-b border-line bg-glass backdrop-blur-xl backdrop-saturate-150">
    <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Principal">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight" aria-label="Inicio">
        <span class="grid size-8 place-items-center rounded-[10px] bg-ink font-mono text-[11px] text-canvas">
          {site.monogram}
        </span>
        <span class="hidden sm:inline">{site.shortName}</span>
      </a>

      <ul class="hidden items-center gap-8 text-[13px] text-muted md:flex">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors duration-300 hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-1">
        <ThemeToggle />
        <button
          id="menu-button"
          type="button"
          class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-surface-2 md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
          <span class="relative block h-3 w-4.5">
            <span class="menu-line absolute left-0 top-0 h-[1.5px] w-full rounded bg-current transition-transform duration-300"></span>
            <span class="menu-line absolute bottom-0 left-0 h-[1.5px] w-full rounded bg-current transition-transform duration-300"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Menú móvil a pantalla completa -->
  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-x-0 top-14 bottom-0 bg-canvas/95 opacity-0 backdrop-blur-xl transition-opacity duration-500 md:hidden"
    inert
  >
    <ul class="flex flex-col gap-1 px-8 pt-8">
      {
        nav.map((item, i) => (
          <li class="menu-item translate-y-2 opacity-0 transition-all duration-500" style={`transition-delay:${80 + i * 40}ms`}>
            <a href={item.href} class="block py-3 text-3xl font-semibold tracking-tight">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  header[data-open] #mobile-menu {
    opacity: 1;
    pointer-events: auto;
  }
  header[data-open] .menu-item {
    opacity: 1;
    transform: none;
  }
  header[data-open] .menu-line:first-child {
    transform: translateY(5.25px) rotate(45deg);
  }
  header[data-open] .menu-line:last-child {
    transform: translateY(-5.25px) rotate(-45deg);
  }
</style>

<script>
  const header = document.querySelector('header')!;
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.inert = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
</script>
