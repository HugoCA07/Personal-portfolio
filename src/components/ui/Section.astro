---
/**
 * Contenedor estándar de sección: mismo espaciado y cabecera en toda la web.
 * Uso: <Section id="x" eyebrow="..." title="..." intro="...">...</Section>
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: className } = Astro.props;
---

<section id={id} class:list={['px-5 py-24 sm:px-8 sm:py-32 lg:py-40', className]}>
  <div class="mx-auto max-w-6xl">
    {
      (eyebrow || title) && (
        <header class="mb-14 max-w-3xl sm:mb-20" data-reveal>
          {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
          {title && (
            <h2 class="text-4xl leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-6xl">
              <Fragment set:html={title} />
            </h2>
          )}
          {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
