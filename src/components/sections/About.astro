---
import Section from '@/components/ui/Section.astro';
import { interests, learning } from '@/data/skills';

const stats = [
  { value: 'C2', label: 'Inglés · LanguageCert' },
  { value: '2', label: 'Ciclos de FP: SMR y DAW' },
  { value: '2º', label: 'DAW, hasta junio de 2027' },
];

const terminal = [
  { cmd: 'whoami', out: 'hugo — dev web en formación' },
  { cmd: 'cat stack.txt', out: 'C++  Java  JS  PHP  Python  SQL' },
  { cmd: './terraforge --seed 42', out: 'generando mundo… ✓ listo' },
];
---

<Section
  id="sobre-mi"
  eyebrow="Sobre mí"
  title="Curiosidad <span class='text-muted'>a tiempo completo.</span>"
>
  <div class="grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-6">
    <!-- Presentación -->
    <article class="card flex flex-col justify-between gap-10 p-8 sm:p-10 md:col-span-2 lg:col-span-4" data-reveal>
      <p class="text-2xl leading-snug font-medium tracking-tight text-balance sm:text-[1.9rem]">
        Hola, soy Hugo. Un programador joven y ambicioso que estudia <span class="text-accent">Desarrollo de Aplicaciones Web</span>{' '}
        y que disfruta construyendo cosas grandes desde cero: de un motor de videojuegos en C++ a aplicaciones con Java y MySQL.
      </p>
      <div>
        <p class="eyebrow mb-3">Ahora aprendiendo</p>
        <ul class="flex flex-wrap gap-2">
          {learning.map((l) => <li class="rounded-full bg-surface-2 px-3.5 py-1.5 text-sm">{l}</li>)}
        </ul>
      </div>
    </article>

    <!-- Datos -->
    <article class="card grid grid-cols-3 gap-4 p-8 sm:p-10 md:col-span-2 lg:col-span-2 lg:grid-cols-1" data-reveal style="--delay:80ms">
      {
        stats.map((s) => (
          <div class="flex flex-col justify-center">
            <p class="text-3xl font-semibold tracking-tighter tabular-nums sm:text-5xl">{s.value}</p>
            <p class="mt-1 text-xs leading-snug text-muted sm:text-sm">{s.label}</p>
          </div>
        ))
      }
    </article>

    <!-- Código -->
    <article class="terminal overflow-hidden rounded-[1.75rem] bg-[#0b0b0f] text-[#e5e5ea] shadow-soft md:col-span-2 lg:col-span-4" data-reveal>
      <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span>
        <span class="size-3 rounded-full bg-[#febc2e]"></span>
        <span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-3 font-mono text-[11px] text-white/40">hugo@portfolio — zsh</span>
      </div>
      <div class="space-y-4 p-6 font-mono text-[13px] leading-relaxed sm:p-8 sm:text-sm">
        {
          terminal.map((t, i) => (
            <div class="line" style={`--i:${i}`}>
              <p>
                <span class="text-[#30d158]">~</span> <span class="text-white/40">$</span> {t.cmd}
              </p>
              <p class="text-white/60">{t.out}</p>
            </div>
          ))
        }
        <p class="line" style={`--i:${terminal.length}`}>
          <span class="text-[#30d158]">~</span> <span class="text-white/40">$</span> <span class="caret"></span>
        </p>
      </div>
    </article>

    <!-- Fuera del código -->
    <article class="card flex flex-col justify-between gap-8 p-8 sm:p-10 md:col-span-2 lg:col-span-2" data-reveal style="--delay:80ms">
      <div>
        <p class="eyebrow">Fuera del código</p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Me gusta entender cómo funcionan las cosas por dentro. Cuando no estoy programando, disfruto de la naturaleza y de los buenos diseños.
        </p>
      </div>
      <ul class="flex flex-wrap gap-2">
        {interests.map((i) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm">{i}</li>)}
      </ul>
    </article>
  </div>
</Section>

<style>
  .terminal .line {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i) * 450ms + 200ms);
  }
  .terminal:global(.is-visible) .line,
  :global(html:not(.js)) .terminal .line {
    opacity: 1;
    transform: none;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: #30d158;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
