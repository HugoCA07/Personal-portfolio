---
/**
 * Portada de un proyecto. Si no tiene `cover`, pinta un marcador de posición
 * coherente (degradado con su color de acento + monograma), nunca una imagen rota.
 */
import { Picture } from 'astro:assets';
import { monogram, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  class?: string;
  sizes?: string;
  eager?: boolean;
}

const { project, class: className, sizes = '(min-width: 768px) 50vw, 100vw', eager = false } = Astro.props;
const { cover, coverAlt, title, accent } = project.data;
---

{
  cover ? (
    <Picture
      src={cover}
      alt={coverAlt ?? `Imagen de ${title}`}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class:list={['size-full object-cover', className]}
      pictureAttributes={{ class: 'contents' }}
    />
  ) : (
    <div class:list={['placeholder relative grid size-full place-items-center overflow-hidden', className]} style={`--c:${accent}`} aria-hidden="true">
      <span class="relative text-[clamp(3rem,9vw,6rem)] font-semibold tracking-[-0.06em] text-white/90">{monogram(title)}</span>
    </div>
  )
}

<style>
  .placeholder {
    background:
      radial-gradient(90% 120% at 0% 0%, color-mix(in oklab, var(--c) 70%, white) 0%, transparent 60%),
      linear-gradient(135deg, var(--c), color-mix(in oklab, var(--c) 35%, black));
  }
  /* Rejilla fina, como papel milimetrado */
  .placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(80% 80% at 50% 50%, black, transparent);
  }
</style>
