---
/** Lista compacta de trabajos de clase: título, de qué va, tecnologías y repositorio. */
import { projectUrl, type Project } from '@/lib/projects';

interface Props {
  courses: Project[];
}

const { courses } = Astro.props;
---

<ul class="divide-y divide-line border-y border-line">
  {
    courses.map((c, i) => (
      <li class="group relative grid gap-x-8 gap-y-1.5 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline" data-reveal style={`--delay:${(i % 4) * 50}ms`}>
        <div class="min-w-0">
          <h3 class="text-lg font-semibold tracking-tight sm:text-xl">
            {/* El enlace cubre toda la fila */}
            <a href={projectUrl(c)} class="after:absolute after:inset-0 group-hover:text-accent">
              {c.data.title}
            </a>
          </h3>
          <p class="mt-1 text-[15px] leading-relaxed text-muted">{c.data.summary}</p>
        </div>
        <div class="flex items-center gap-4 font-mono text-xs text-muted sm:justify-end">
          <span class="truncate">{c.data.stack.join(' · ')}</span>
          {c.data.status && <span class="shrink-0 rounded-full bg-surface-2 px-2.5 py-1 text-[11px]">{c.data.status}</span>}
          {c.data.repo && (
            <a
              href={c.data.repo}
              target="_blank"
              rel="noopener"
              class="relative z-10 shrink-0 rounded-full px-2 py-1 transition-colors hover:bg-surface-2 hover:text-ink"
              aria-label={`Repositorio de ${c.data.title} en GitHub`}
            >
              GitHub ↗
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>
