---
import Section from '@/components/ui/Section.astro';
import { timeline } from '@/data/timeline';

const first = timeline[0]?.year;
---

<!-- Trayectoria como lista editorial: año grande a la izquierda, hito a la derecha -->
<Section
  id="trayectoria"
  eyebrow="Trayectoria"
  title={`De ${first} a hoy`}
  layout="split"
  intro="Dos ciclos de FP, unas prácticas como técnico y los proyectos que he ido construyendo por el camino."
>
  <ol class="border-t border-line">
    {
      timeline.map((m, i) => (
        <li
          class:list={[
            'group grid gap-x-10 gap-y-2 border-b border-line py-8 sm:grid-cols-[10rem_minmax(0,1fr)] sm:py-10 lg:grid-cols-[11rem_minmax(0,1fr)_minmax(0,1fr)]',
            m.future && 'opacity-60',
          ]}
          data-reveal
          style={`--delay:${(i % 3) * 50}ms`}
        >
          <p
            class:list={[
              'flex items-center gap-3 font-mono text-sm tracking-[0.08em] uppercase tabular-nums',
              m.current ? 'text-accent' : 'text-muted',
            ]}
          >
            {m.current && <span class="size-2 animate-pulse rounded-full bg-accent" aria-hidden="true" />}
            {m.year}
          </p>
          <h3 class="text-2xl font-semibold tracking-tight text-balance transition-transform duration-500 ease-(--ease-apple) sm:text-3xl lg:group-hover:translate-x-1">
            {m.title}
          </h3>
          <p class="leading-relaxed text-muted sm:col-start-2 lg:col-start-3 lg:row-start-1">{m.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
