---
/**
 * Escena "Por dentro": un portátil real, de cerrado a desmontado, contado con fotografías
 * que se funden al hacer scroll.
 * - Fotos, tramos y textos: `src/data/teardown.ts`.
 * - Pintado: `src/lib/teardown-renderer.ts` (fundido de fotos; intercambiable).
 * - Progreso: `src/lib/scroll-progress.ts` (el mismo helper que usa el hero).
 * Con `prefers-reduced-motion` (o sin JS) se muestra una versión estática: foto + texto en lista.
 */
import { Picture } from 'astro:assets';
import { stages } from '@/data/teardown';
import { url } from '@/lib/url';

const pad = (n: number) => String(n).padStart(2, '0');
const sizes = '100vw';
const widths = [640, 1024, 1600, 2200];
---

<section id="por-dentro" class="teardown relative bg-[#050506] text-white" aria-labelledby="teardown-title" data-teardown data-dark style="--p:0">
  <h2 id="teardown-title" class="sr-only">Por dentro: un portátil, pieza a pieza</h2>

  <!-- Versión animada: fotos a pantalla completa fijas mientras se hace scroll -->
  <div class="animated sticky top-0 h-svh overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      {
        stages.map((s, i) => (
          <div class="shot absolute inset-0" data-shot data-from={s.from} data-to={s.to} style={i === 0 ? undefined : 'opacity:0;visibility:hidden'}>
            <Picture
              src={s.image}
              alt=""
              formats={['avif', 'webp']}
              widths={widths}
              sizes={sizes}
              loading="lazy"
              class="size-full object-cover will-change-transform"
              style={`object-position:${s.focus ?? '50% 50%'}`}
              pictureAttributes={{ class: 'contents' }}
            />
          </div>
        ))
      }
      <div class="scrim absolute inset-0"></div>
    </div>

    <!-- Textos de cada tramo (contenido real, accesible) -->
    <div class="copy absolute inset-x-0 bottom-0 px-6 pb-12 sm:px-10 sm:pb-16 lg:inset-y-0 lg:right-auto lg:flex lg:w-[46%] lg:items-center lg:pb-0 lg:pl-[max(2.5rem,calc((100vw-72rem)/2))]">
      <ol class="stages grid w-full max-w-md">
        {
          stages.map((s, i) => (
            <li class="stage" data-stage data-from={s.from} data-to={s.to} style={i === 0 ? undefined : 'opacity:0'}>
              <p class="font-mono text-xs tracking-[0.16em] text-[#64b5ff] uppercase">{s.kicker}</p>
              <h3 class="mt-3 text-[clamp(1.9rem,4.4vw,3.25rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-balance">{s.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-white/75 sm:text-lg">{s.text}</p>
              {s.link && (
                <a href={url(s.link.href)} class="group mt-5 inline-flex items-center gap-1 text-sm font-medium text-[#64b5ff]">
                  {s.link.label} <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </a>
              )}
              <p class="mt-6 font-mono text-[10px] text-white/45">
                Foto:{' '}
                <a href={s.credit.url} target="_blank" rel="noopener" class="underline-offset-2 hover:text-white hover:underline">
                  {s.credit.author} · Unsplash
                </a>
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Contador y progreso -->
    <p class="counter absolute top-24 right-6 font-mono text-xs tracking-[0.16em] text-white/60 tabular-nums sm:right-10" aria-hidden="true">
      <span data-counter>01</span> / {pad(stages.length)}
    </p>
    <div class="absolute inset-x-0 bottom-0 h-px bg-white/10" aria-hidden="true">
      <div class="bar h-full origin-left bg-[#2997ff]"></div>
    </div>
  </div>

  <!-- Versión estática (movimiento reducido o sin JS) -->
  <ol class="still mx-auto max-w-6xl space-y-20 px-5 py-24 sm:px-8">
    {
      stages.map((s, i) => (
        <li class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
          <Picture
            src={s.image}
            alt={s.alt}
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
            class="aspect-[16/10] w-full rounded-card object-cover"
            style={`object-position:${s.focus ?? '50% 50%'}`}
            pictureAttributes={{ class: i % 2 === 1 ? 'md:order-2' : '' }}
          />
          <div>
            <p class="font-mono text-xs tracking-[0.16em] text-[#64b5ff] uppercase">{s.kicker}</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">{s.title}</h3>
            <p class="mt-3 text-lg leading-relaxed text-white/75">{s.text}</p>
            {s.link && (
              <a href={url(s.link.href)} class="mt-5 inline-flex text-sm font-medium text-[#64b5ff]">
                {s.link.label} →
              </a>
            )}
            <p class="mt-5 font-mono text-[10px] text-white/45">
              Foto:{' '}
              <a href={s.credit.url} target="_blank" rel="noopener" class="hover:text-white hover:underline">
                {s.credit.author} · Unsplash
              </a>
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .teardown {
    height: 620svh;
  }
  /* Oscurece la foto donde va el texto: abajo en móvil, a la izquierda en escritorio */
  .scrim {
    background:
      linear-gradient(to top, rgb(5 5 6 / 0.92) 0%, rgb(5 5 6 / 0.55) 38%, rgb(5 5 6 / 0) 65%),
      linear-gradient(to bottom, rgb(5 5 6 / 0.55), rgb(5 5 6 / 0) 22%);
  }
  @media (min-width: 1024px) {
    .scrim {
      background:
        linear-gradient(to right, rgb(5 5 6 / 0.9) 0%, rgb(5 5 6 / 0.6) 32%, rgb(5 5 6 / 0) 62%),
        linear-gradient(to bottom, rgb(5 5 6 / 0.5), rgb(5 5 6 / 0) 20%);
    }
  }
  .stage {
    grid-area: 1 / 1;
    align-self: end;
  }
  @media (min-width: 1024px) {
    .stage {
      align-self: center;
    }
  }
  .stage:focus-within {
    opacity: 1 !important;
  }
  .bar {
    transform: scaleX(var(--p));
  }

  /* Por defecto (sin JS) solo la versión estática */
  .animated {
    display: none;
  }
  :global(html.js) .teardown .animated {
    display: block;
  }
  :global(html.js) .teardown .still {
    display: none;
  }
  :global(html:not(.js)) .teardown {
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .teardown {
      height: auto !important;
    }
    :global(html.js) .teardown .animated {
      display: none;
    }
    :global(html.js) .teardown .still {
      display: block;
    }
  }
</style>

<script>
  import { createPhotoRenderer, fade, type TeardownRenderer } from '@/lib/teardown-renderer';
  import { prefersReducedMotion, scrollProgress } from '@/lib/scroll-progress';

  const root = document.querySelector<HTMLElement>('[data-teardown]')!;
  const stageEls = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
  const counter = root.querySelector<HTMLElement>('[data-counter]')!;

  // Para usar otro renderizador (p. ej. un vídeo o frames en <canvas>), cámbialo aquí.
  const renderer: TeardownRenderer = createPhotoRenderer(root);

  scrollProgress(root, {
    reducedValue: 1,
    onProgress(p) {
      if (prefersReducedMotion()) return;
      renderer.render(p);
      let current = 0;
      stageEls.forEach((el, i) => {
        const o = fade(p, Number(el.dataset.from), Number(el.dataset.to));
        if (p >= Number(el.dataset.from)) current = i;
        el.style.opacity = o.toFixed(3);
        el.style.transform = `translateY(${((1 - o) * 14).toFixed(1)}px)`;
        el.style.visibility = o === 0 ? 'hidden' : 'visible';
      });
      counter.textContent = String(current + 1).padStart(2, '0');
    },
  });
</script>
