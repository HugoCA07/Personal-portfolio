---
import Section from '@/components/ui/Section.astro';
import { skillGroups } from '@/data/skills';
---

<Section
  id="stack"
  eyebrow="Stack"
  title="Mis herramientas."
  intro="Las tecnologías con las que trabajo cada día. Unas las domino, otras las estoy aprendiendo."
  class="bg-surface-2/60"
>
  <div class="grid gap-5 md:grid-cols-3">
    {
      skillGroups.map((g, i) => (
        <article class="card p-8 sm:p-9" data-reveal style={`--delay:${i * 80}ms`}>
          <p class="eyebrow">{g.caption}</p>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight">{g.title}</h3>
          <ul class="mt-8 divide-y divide-line">
            {g.items.map((item) => (
              <li class="flex items-center justify-between py-3 text-[15px]">
                <span>{item}</span>
                <span class="size-1.5 rounded-full bg-accent/70" aria-hidden="true" />
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
