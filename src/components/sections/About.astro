---
/**
 * Sobre mí: perfil profesional breve. Sin aficiones ni datos personales, y sin datos que ya
 * estén en otra sección (formación → Trayectoria, prácticas → Experiencia, proyectos → Proyectos,
 * tecnologías e idiomas → Stack).
 */
import Portrait from '@/components/ui/Portrait.astro';
import { learning } from '@/data/skills';
import { showPortrait } from '@/lib/portrait';
---

<section id="sobre-mi" class="px-5 py-24 sm:px-8 sm:py-32 lg:py-40">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow mb-10" data-reveal>Perfil</p>

    <div class="grid gap-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-20">
      <div data-reveal>
        <p class="text-[clamp(1.85rem,3.6vw,2.8rem)] leading-[1.16] font-semibold tracking-[-0.03em] text-balance">
          Desarrollador web en formación con base en sistemas,{' '}
          <span class="text-muted">capaz de trabajar tanto en el software como en el equipo en el que se ejecuta.</span>
        </p>
      </div>

      <div class="space-y-12" data-reveal style="--delay:80ms">
        {showPortrait && <Portrait class="aspect-[4/5] w-full" />}
        <p class="text-lg leading-relaxed text-muted">
          Combino la formación en sistemas —montaje, diagnóstico y redes— con el desarrollo de aplicaciones: interfaces, backend y bases de datos.
        </p>
        <div>
          <p class="eyebrow mb-3">Ahora aprendiendo</p>
          <ul class="flex flex-wrap gap-2">
            {learning.map((l) => <li class="rounded-full bg-surface-2 px-3.5 py-1.5 text-sm">{l}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
