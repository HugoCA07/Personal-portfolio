---
import { Picture } from 'astro:assets';
import { site } from '@/config/site';
import heroImage from '@/assets/hero-mountains.jpg';

// Para cambiar la foto, sustituye src/assets/hero-mountains.jpg y actualiza el crédito.
const photo = { author: 'Go Wild', url: 'https://unsplash.com/photos/V0yAek6BgGk' };
---

<!-- La sección es más alta que la pantalla: el contenido queda fijo (sticky) y la animación avanza con el scroll -->
<section class="hero relative h-[185svh]" aria-labelledby="hero-title" style="--p:0">
  <div class="sticky top-0 h-svh overflow-hidden">
    <div class="frame absolute inset-0 overflow-hidden bg-[#0b1a2e]">
      <div class="intro-zoom size-full">
        <Picture
          src={heroImage}
          alt="Cordillera nevada bajo un cielo azul"
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="photo size-full object-cover"
          pictureAttributes={{ class: "block size-full" }}
        />
      </div>
      <div class="shade absolute inset-0" aria-hidden="true"></div>
    </div>

    <!-- Fase 1: nombre -->
    <div class="title absolute inset-0 flex flex-col items-center justify-center px-5 text-center text-white">
      <p class="hero-in font-mono text-xs tracking-[0.18em] text-white/75 uppercase" style="--d:150ms">Portfolio · {new Date().getFullYear()}</p>
      <h1 id="hero-title" class="hero-in mt-5 text-[clamp(3.4rem,12.5vw,10rem)] leading-[0.9] font-semibold tracking-[-0.05em]" style="--d:250ms">
        {site.name.split(' ').slice(0, 2).join(' ')}<span class="text-accent">.</span>
      </h1>
      <p class="hero-in mt-6 max-w-xl text-lg leading-relaxed text-balance text-white/85 sm:text-2xl" style="--d:350ms">
        {site.role}. Construyo cosas desde cero, del motor de un juego a la web.
      </p>
      <div class="hero-in mt-9 flex flex-wrap items-center justify-center gap-3" style="--d:450ms">
        <a
          href="#proyectos"
          class="rounded-full bg-white px-6 py-3 text-sm font-medium text-[#1d1d1f] transition-transform duration-300 hover:scale-[1.03] active:scale-[0.98]"
        >
          Ver proyectos
        </a>
        <a href="#contacto" class="group rounded-full px-5 py-3 text-sm font-medium text-white">
          Hablemos <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <!-- Fase 2: frase que aparece al deslizar -->
    <div class="statement pointer-events-none absolute inset-0 flex items-center justify-center px-6 text-center" aria-hidden="true">
      <p class="max-w-4xl text-[clamp(2rem,6vw,4.5rem)] leading-[1.05] font-semibold tracking-[-0.035em] text-balance text-white">
        Código limpio, ideas grandes <span class="text-white/70">y siempre otra cima por subir.</span>
      </p>
    </div>

    <div class="cue absolute inset-x-0 bottom-8 flex flex-col items-center gap-2 text-white/70" aria-hidden="true">
      <span class="font-mono text-[10px] tracking-[0.2em] uppercase">Desliza</span>
      <span class="cue-line block h-8 w-px bg-white/60"></span>
    </div>

    <a
      href={photo.url}
      target="_blank"
      rel="noopener"
      class="credit absolute right-4 bottom-4 font-mono text-[10px] text-white/50 transition-colors hover:text-white sm:right-6"
    >
      Foto: {photo.author} · Unsplash
    </a>
  </div>
</section>

<style>
  /* --p va de 0 a 1 según el scroll dentro de la sección (lo calcula el script) */
  .frame {
    clip-path: inset(
      calc(var(--p) * 3.5%) calc(var(--p) * 4%) calc(var(--p) * 3.5%) calc(var(--p) * 4%) round calc(var(--p) * 2.25rem)
    );
  }
  .photo {
    transform: scale(calc(1.16 - var(--p) * 0.16)) translateY(calc(var(--p) * 3%));
    transform-origin: 50% 40%;
  }
  .shade {
    background:
      radial-gradient(60% 45% at 50% 50%, rgb(0 0 0 / 0.38), transparent 75%),
      linear-gradient(180deg, rgb(0 0 0 / 0.35) 0%, rgb(0 0 0 / 0.05) 35%, rgb(0 0 0 / 0.05) 60%, rgb(0 0 0 / 0.45) 100%),
      rgb(0 0 0 / calc(var(--p) * 0.35));
  }
  .title,
  .statement {
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.35);
  }
  .title {
    opacity: clamp(0, 1 - var(--p) * 2.6, 1);
    transform: translateY(calc(var(--p) * -14vh)) scale(calc(1 - var(--p) * 0.08));
  }
  .statement {
    opacity: clamp(0, (var(--p) - 0.38) * 3.2, 1);
    transform: translateY(calc((1 - var(--p)) * 6vh));
  }
  .cue,
  .credit {
    opacity: clamp(0, 1 - var(--p) * 5, 1);
  }
  .cue-line {
    transform-origin: top;
    animation: cue 2.2s var(--ease-apple) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  .intro-zoom {
    animation: intro-zoom 2.4s var(--ease-apple) both;
  }
  @keyframes intro-zoom {
    from {
      transform: scale(1.12);
      filter: blur(8px) brightness(0.7);
    }
  }
  .hero-in {
    animation: hero-in 1.2s var(--ease-apple) both;
    animation-delay: var(--d);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }
    .statement {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  let ticking = false;
  const update = () => {
    ticking = false;
    if (reduced.matches) return hero.style.setProperty('--p', '0');
    const range = hero.offsetHeight - innerHeight;
    const p = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / range));
    hero.style.setProperty('--p', p.toFixed(4));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>
