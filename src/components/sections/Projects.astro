---
import Section from '@/components/ui/Section.astro';
import FeaturedProject from '@/components/ui/FeaturedProject.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { getProjects } from '@/lib/projects';

// El primer proyecto destacado ocupa el escaparate; el resto, tarjetas.
const featured = await getProjects((p) => p.data.featured);
const [hero, ...restFeatured] = featured;
const more = (await getProjects((p) => !p.data.featured)).slice(0, Math.max(0, 4 - restFeatured.length));
const cards = [...restFeatured, ...more];
const total = (await getProjects()).length;
---

<Section
  id="proyectos"
  eyebrow="Proyectos"
  title="Construido desde cero. <span class='text-muted'>Pieza a pieza.</span>"
  intro="Una selección de lo que he hecho: motores de juego, aplicaciones de escritorio y la web. Cada proyecto incluye su ficha técnica."
>
  <div class="space-y-5">
    {hero && <FeaturedProject project={hero} />}
    <div class="grid gap-5 md:grid-cols-2">
      {cards.map((p, i) => <ProjectCard project={p} delay={(i % 2) * 80} />)}
    </div>
  </div>

  <div class="mt-14 flex justify-center" data-reveal>
    <a
      href="/proyectos"
      class="group inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 text-sm font-medium transition-colors hover:bg-surface-2"
    >
      Ver los {total} proyectos
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</Section>
