---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecSheet from '@/components/ui/SpecSheet.astro';
import PixelWorld from '@/components/ui/PixelWorld.astro';
import ProjectCover from '@/components/ui/ProjectCover.astro';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import { Picture } from 'astro:assets';
import { getProjects, metaLine, projectUrl, type Project } from '@/lib/projects';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, specs, stack, status, year, repo, demo, team, accent, category, cover, gallery, video, videoPoster } = project.data;
const facts = [
  ...specs,
  ...(year ? [{ label: 'Año', value: String(year) }] : []),
  ...(status ? [{ label: 'Estado', value: status }] : []),
];
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article style={`--accent-p:${accent}`}>
    <header class="relative overflow-hidden px-5 pt-36 pb-20 sm:px-8 sm:pt-44 sm:pb-28">
      <div
        class="absolute inset-0 -z-10 opacity-[0.14] dark:opacity-25"
        style="background: radial-gradient(70% 60% at 50% 0%, var(--accent-p), transparent 70%)"
        aria-hidden="true"
      >
      </div>
      <div class="mx-auto max-w-4xl text-center">
        <a href={url('/proyectos/')} class="eyebrow inline-flex items-center gap-2 transition-colors hover:text-ink">← Todos los proyectos</a>
        <p class="eyebrow mt-10 flex items-center justify-center gap-2">
          <span class="size-2 rounded-full bg-(--accent-p)"></span>
          {metaLine(project)}
        </p>
        <h1 class="mt-5 text-[clamp(2.75rem,9vw,6rem)] leading-[0.95] font-semibold tracking-[-0.045em] text-balance">{title}</h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{summary}</p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          {
            repo && (
              <a href={repo} target="_blank" rel="noopener" class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas transition-transform hover:scale-[1.03]">
                Ver en GitHub
              </a>
            )
          }
          {
            demo && (
              <a href={demo} target="_blank" rel="noopener" class="rounded-full border border-line px-6 py-3 text-sm font-medium transition-colors hover:bg-surface-2">
                Ver demo
              </a>
            )
          }
        </div>
      </div>
    </header>

    {/* Cabecera visual: portada, o el terreno de TerraForge, o un marcador de posición */}
    {
      (cover || project.id === 'terraforge' || category !== 'course') && (
        <div class="px-5 sm:px-8">
          {cover || project.id !== 'terraforge' ? (
            <div class="mx-auto aspect-[16/10] max-w-6xl overflow-hidden rounded-card sm:aspect-[16/8]">
              <ProjectCover project={project} eager sizes="(min-width: 1152px) 1152px, 100vw" />
            </div>
          ) : (
            <div class="mx-auto max-w-6xl overflow-hidden rounded-card bg-[radial-gradient(120%_90%_at_70%_0%,#1d3b2a,#050706)] sm:h-80">
              <PixelWorld seed={42} cols={96} rows={32} class="block h-auto w-full" />
            </div>
          )}
        </div>
      )
    }

    <div class="mx-auto grid max-w-6xl gap-14 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1fr_20rem]">
      <div class="min-w-0">
        <div class="prose-apple max-w-2xl">
          <Content />
        </div>

        {
          video && (
            <figure class="mt-16">
              <div class="overflow-hidden rounded-card border border-line">
                <LazyVideo src={video} poster={videoPoster} label={`Vídeo de ${title}`} class="aspect-video" />
              </div>
              <figcaption class="mt-3 text-sm text-muted">{title} en movimiento.</figcaption>
            </figure>
          )
        }

        {
          gallery.length > 0 && (
            <div class="mt-16 grid gap-5 sm:grid-cols-2">
              {gallery.map((g, i) => (
                <figure class:list={[gallery.length % 2 === 1 && i === 0 && 'sm:col-span-2']} data-reveal>
                  <div class="overflow-hidden rounded-card border border-line bg-surface-2">
                    <Picture
                      src={g.src}
                      alt={g.alt}
                      formats={['avif', 'webp']}
                      widths={[600, 1000, 1600]}
                      sizes="(min-width: 1024px) 50vw, 100vw"
                      loading="lazy"
                      class="h-auto w-full"
                    />
                  </div>
                  {g.caption && <figcaption class="mt-3 text-sm text-muted">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }
      </div>
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class="card p-6">
          <p class="eyebrow mb-2">Ficha técnica</p>
          <SpecSheet specs={facts} />
        </div>
        <div class:list={[stack.length === 0 && 'hidden']}>
          <p class="eyebrow mb-3">Tecnologías</p>
          <ul class="flex flex-wrap gap-2">
            {stack.map((s) => <li class="rounded-full bg-surface-2 px-3 py-1.5 text-sm">{s}</li>)}
          </ul>
        </div>
        {
          team && (
            <div>
              <p class="eyebrow mb-3">Equipo</p>
              <ul class="space-y-1 text-sm text-muted">
                {team.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <nav class="border-t border-line px-5 sm:px-8" aria-label="Siguiente proyecto">
      <a href={projectUrl(next)} class="group mx-auto flex max-w-6xl items-center justify-between gap-6 py-14 sm:py-20">
        <div>
          <p class="eyebrow">Siguiente proyecto</p>
          <p class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{next.data.title}</p>
        </div>
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-surface-2 text-xl transition-all duration-500 group-hover:translate-x-1 group-hover:bg-ink group-hover:text-canvas">
          →
        </span>
      </a>
    </nav>
  </article>
</BaseLayout>
